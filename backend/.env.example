# Copier ce fichier en .env puis adapter les valeurs.
PORT=3000
NODE_ENV=development

# Base SQLite (créée automatiquement au premier démarrage).
DB_PATH=./data/it-equipment.db

# Secret de signature des JWT : chaîne aléatoire longue (>= 32 caractères).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN_LONG=30d

# Compte propriétaire, créé au premier démarrage si aucun utilisateur n'existe.
ADMIN_EMAIL=proprietaire@it-equipment.fr
ADMIN_NOM=Propriétaire
ADMIN_PASSWORD=

# Origines autorisées par CORS (séparées par des virgules).
CORS_ORIGINS=http://localhost:5173

# Fuseau horaire utilisé pour le dashboard (jours, mois) et les références de commande.
BUSINESS_TIMEZONE=Europe/Paris
